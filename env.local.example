# Agora credentials
# Required: found in Agora Console → your project → "App ID"
NEXT_PUBLIC_AGORA_APP_ID=

# Required: found in Agora Console → your project → "App Certificate"
# Server-side only. Never expose this in client code.
NEXT_AGORA_APP_CERTIFICATE=

# Optional: Murf TTS (BYOK). Get the key from https://murf.ai/api/dashboard
# When set, the agent speaks with Murf instead of the default MiniMax voice.
NEXT_MURF_API_KEY=
# Optional overrides (defaults: Ariana / en-US)
NEXT_MURF_VOICE_ID=
NEXT_MURF_LOCALE=
